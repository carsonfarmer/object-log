; object-log durable format version 1
; All top-level values are stored as an envelope. The envelope payload is the
; canonical CBOR encoding of one index, entry, base, node, collection plan, or
; recovery token.

envelope = {
  1: bstr,                         ; encoded payload
  2: digest                        ; BLAKE3 of encoded payload
}

index = {
  1: 1,                            ; format version
  2: log-id,
  3: uint,                         ; generation
  4: uint,                         ; next sequence
  ? 5: checkpoint-ref,
  6: [* entry-pointer],            ; active ordered tail
  7: [* entry-pointer],            ; bounded outcome window
  8: incarnation-id,               ; random durable log incarnation
  9: options,                      ; durable log contract
  10: uint,                        ; monotonic collection epoch
  ? 11: collection-plan-ref,       ; active positive deletion plan
  12: [* retention-id]             ; strictly sorted, unique reader retentions
}

options = {
  1: uint,                         ; maximum active tail entries
  2: uint,                         ; outcome resolution window
  3: uint,                         ; maximum inline operation bytes
  4: uint,                         ; maximum inline result bytes
  5: uint,                         ; maximum refs per entry, base, or node
  6: uint,                         ; maximum encoded entry bytes
  7: uint,                         ; maximum encoded index bytes
  8: uint,                         ; maximum encoded base bytes
  9: uint,                         ; maximum immutable object bytes
  10: uint,                        ; maximum retention IDs
  11: uint,                        ; per-publication count and exact collection limit
  12: uint                         ; maximum encoded collection-plan bytes
}

; An entry has no assigned sequence. The index entry-pointer assigns it.
entry = {
  1: 1,                            ; format version
  2: log-id,
  3: transaction-id,
  ? 4: digest,                     ; expected prior tip
  5: bstr,                         ; opaque operation
  6: bstr,                         ; opaque recorded result
  7: [* object-ref<data-kind>],
  8: incarnation-id                ; durable log incarnation
}

base = {
  1: 1,                            ; format version
  2: log-id,
  3: uint,                         ; covered sequence
  4: digest,                       ; covered entry digest
  5: bstr,                         ; opaque snapshot
  6: incarnation-id,               ; durable log incarnation
  7: [* object-ref<data-kind>]     ; all immutable objects needed by this base
}

reference-node = {
  1: 1,                            ; format version
  2: bstr,                         ; opaque adapter payload
  3: [* object-ref<data-kind>]     ; payload or reference-node children
}

; Caller-owned recovery token. Persist before attempting publication.
; The source digest is BLAKE3 of the canonical enveloped source index.
; The publication-base digest is BLAKE3 of that index's canonical envelope
; after setting generation to max(next sequence, collection epoch) and clearing
; retention IDs. The options digest is BLAKE3 of the bare canonical options CBOR.
recovery-token = {
  1: 1,                            ; format version
  2: digest,                       ; source index digest
  ? 3: tstr,                       ; source ETag
  ? 4: tstr,                       ; source storage version
  5: transaction-id,
  6: bstr,                         ; opaque operation
  7: bstr,                         ; opaque recorded result
  8: [* object-ref<data-kind>],
  9: storage-id,                   ; exact entry physical identity
  10: digest,                      ; publication-base digest
  11: uint,                        ; source generation
  12: uint,                        ; source next sequence
  ? 13: digest,                    ; source tip
  14: log-id,
  15: incarnation-id,
  16: digest                       ; options digest
}

entry-pointer = {
  1: uint,                         ; assigned sequence
  2: transaction-id,
  3: digest,
  4: uint,                         ; encoded envelope length
  5: storage-id                    ; private physical identity
}

checkpoint-ref = {
  1: uint,                         ; covered sequence
  2: digest,                       ; covered entry digest
  3: object-ref<2>
}

object-ref<kind> = {
  1: kind,
  2: digest,
  3: uint,                         ; byte length
  4: storage-id,                   ; private physical identity
  5: uint .gt 0                    ; blob=1; node/checkpoint=1+sum(child counts), per path
}

collection-plan-ref = {
  1: storage-id,
  2: digest,
  3: uint                          ; encoded envelope length
}

collection-plan = {
  1: 1,                            ; format version
  2: log-id,
  3: uint,                         ; positive collection epoch
  4: [+ collection-candidate]      ; strictly sorted positive deletion set
}

collection-candidate = {
  1: incarnation-id,
  2: immutable-kind,
  3: storage-id,
  4: digest,
  5: uint                          ; listed object bytes
}

data-kind = 1 / 3                 ; payload / reference node; base is 2
immutable-kind = 1 / 2 / 3 / 4 / 5 ; entry / payload / node / base / plan
digest = bstr .size 32
transaction-id = bstr .size 16
retention-id = bstr .size 16
storage-id = bstr .size 16
incarnation-id = bstr .size 16
log-id = tstr .regexp "[A-Za-z0-9._-]{1,128}"
; The log IDs "." and ".." are additionally forbidden.
