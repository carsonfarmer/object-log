; object-log-sqlite durable record version 1
; Store each record as canonical CBOR. CDDL does not express the alignment and
; cross-field length checks listed after these four exact array forms.

sqlite-record = snapshot-inline / snapshot-chunked / wal-inline / wal-chunked

snapshot-inline = [0, bstr]        ; complete snapshot

snapshot-chunked = [1, [payload-length, chunk-count]]

wal-inline = [2, [
  bstr,                            ; complete WAL frame range
  bstr .size 32,                   ; SQLite WAL header
  frame-count,                     ; prior mxFrame
  frame-count                      ; new mxFrame
]]

wal-chunked = [3, [
  payload-length,
  chunk-count,
  bstr .size 32,
  frame-count,
  frame-count
]]

payload-length = uint .gt 0
chunk-count = 1..4294967295
frame-count = 0..4294967295

; Snapshot payload bytes and each snapshot chunk are multiples of 4096.
; WAL payload bytes and each WAL chunk are multiples of 4120.
; An inline byte string has no object references.
; A chunked record has chunk-count ordered object references.
; For WAL, mxFrame is greater than prior mxFrame and payload-length equals
; (mxFrame - prior mxFrame) * 4120.
