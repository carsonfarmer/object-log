# Copy outside the repository, replace examples, source it, then export secrets.
export GIT_QUALIFICATION_ID=replace-with-campaign-id
export GIT_QUALIFICATION_REVISION=replace-with-full-commit-sha
export GIT_QUALIFICATION_REGION=replace-with-region
export GIT_QUALIFICATION_S3_ENDPOINT=https://s3.${GIT_QUALIFICATION_REGION}.amazonaws.com
export GIT_QUALIFICATION_BUCKET=replace-with-dedicated-unversioned-bucket
export GIT_QUALIFICATION_PREFIX=object-log-qualification/${GIT_QUALIFICATION_ID}
export GIT_QUALIFICATION_ENCRYPTION=AES256
export GIT_QUALIFICATION_CREDENTIAL_SOURCE=replace-with-reviewed-temporary-identity
export GIT_QUALIFICATION_CREDENTIAL_EXPIRES_AT=replace-with-rfc3339-expiry
export GIT_QUALIFICATION_REQUEST_LIMIT=1000000
export GIT_QUALIFICATION_COST_LIMIT_USD=25.00
export GIT_QUALIFICATION_TIME_LIMIT_SECONDS=39600
export GIT_QUALIFICATION_COUNTER_SOURCE=provider-billing-and-spin-service-log
export GIT_QUALIFICATION_ADMISSION=replace-with-reviewed-host-limits
export GIT_QUALIFICATION_STATE_DIR=/absolute/path/outside/repository/qualification-state
export GIT_PROBE_URL=https://replace-with-deployed-git-host
export GIT_PROBE_BRANCH=main
export GIT_PROBE_BOOT_ID=standard-boot-1

# Keep secrets out of this file:
# export AWS_ACCESS_KEY_ID=...
# export AWS_SECRET_ACCESS_KEY=...
# export AWS_SESSION_TOKEN=...
# export GIT_PROBE_PASSWORD=...
