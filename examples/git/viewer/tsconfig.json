{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "ESNext.TypedArrays", "DOM", "WebWorker"],
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "object-log:storage/wal@0.1.0": ["./build/types/interfaces/object-log-storage-wal.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "build.ts", "prepare.ts"]
}
