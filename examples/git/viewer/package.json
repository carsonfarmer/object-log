    "@types/bun": "1.3.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@bytecodealliance/componentize-js": "0.23.0"
  },
  "dependencies": {
    "@spinframework/wasi-http-proxy": "2.0.0",
    "preact": "10.29.8"
  }
